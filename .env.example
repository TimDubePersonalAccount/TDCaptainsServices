# Example only: replace placeholders privately in ignored .env.local.
# Confirm the SMTP provider and authorized sender with the site owner.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-app-password
SERVICE_REQUEST_FROM_EMAIL=sender@example.com
SERVICE_REQUEST_TO_EMAIL=recipient@example.com
